# Copie para .env e preencha. O .env esta no .gitignore e NUNCA deve ser commitado.
# Nenhum valor aqui: apenas os nomes das variaveis.

# Endpoint do provedor (OpenAI, Mistral, ou um modelo local compativel).
# Deixe vazio para usar o padrao da biblioteca openai.
LLM_BASE_URL=

# Chave do provedor de modelo. Nao e chave do TMDB.
OPENAI_API_KEY=

# Id do modelo, como o provedor o chama.
MODEL_NAME=

# Temperatura das chamadas. Sem valor, o codigo usa 0.2.
TEMPERATURE=
